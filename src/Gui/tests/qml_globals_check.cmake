# qml_globals_lint_test: THE NAMES QML READS ARE THE NAMES C++ GIVES IT (R-QML-1: "context globals are only devices,
# settings, logging and `app`"). It reads the source tree at run time, so it needs no build when the code changes, and it
# is plain CMake, so it runs on every builder. Three checks:
#   1. the context globals src/Gui/main.cpp registers are exactly the ruled list below;
#   2. no production QML or JS file (src/Gui, skipping tests/) reads one of the five names that moved under `app` bare.
#      A name its own object declares (`property var controller`) is that property: allowed inside that object, or in
#      the whole file when the file's root object declares it. A binding or object key (`ttsController: v`) is not a
#      read;
#   3. every `app.<member>` such a file reads is a property, invokable or signal of GuiApp (src/Gui/app/gui_app.h) or
#      App (src/App/app.h), or a QObject member: QML resolves a misspelt `app.ttsControler` to undefined without a word.
#
#   cmake -DGUI=<src/Gui> -DAPPH=<src/App/app.h> -P qml_globals_check.cmake
#
# What it does not see: strings, comments and template literals are blanked first, so a name built at run time is not
# checked; a property's scope is taken as its object's braces, which also covers that object's children.
cmake_policy(VERSION 3.21)
if(NOT GUI OR NOT APPH)
  message(FATAL_ERROR "GUI and APPH must be set")
endif()
get_filename_component(GUI "${GUI}" ABSOLUTE)     # the tests tree passes src/Gui/tests/..

# The ruled list (R-QML-1). A change here is a change to the rule's application: the Solution Architect's.
set(_ruled app appLog appSettings bufferController cameraManager imuManager launchMonitor liveWrist ppcpHost
           ppcpOffers secrets trunkCeremony)
# The five that moved under `app` (the Product Owner's and the Solution Architect's rulings, 26 Nov 2026).
set(_moved ttsController controller profiler resourceMonitor cudaRuntime)
# QObject's own QML-visible members.
set(_qobject objectName objectNameChanged destroyed deleteLater)

set(_fail "")
string(ASCII 1 _SEMI)
string(ASCII 2 _LBR)
string(ASCII 3 _RBR)
string(ASCII 4 _BSL)

# ── 1. the globals main.cpp registers ─────────────────────────────────────────────────────────────────────────────
file(READ "${GUI}/main.cpp" _main)
string(REGEX MATCHALL "setContextProperty[ \t\r\n]*\\(" _calls "${_main}")
string(REGEX MATCHALL "setContextProperty[ \t\r\n]*\\([ \t\r\n]*QStringLiteral[ \t\r\n]*\\([ \t\r\n]*\"[A-Za-z_][A-Za-z0-9_]*\""
       _named "${_main}")
list(LENGTH _calls _ncalls)
list(LENGTH _named _nnamed)
if(NOT _ncalls EQUAL _nnamed)
  string(APPEND _fail "main.cpp: ${_ncalls} setContextProperty calls, but only ${_nnamed} name a QStringLiteral: "
                      "every global must be named so this check can read it\n")
endif()
set(_registered "")
foreach(_n IN LISTS _named)
  string(REGEX REPLACE ".*\"([A-Za-z_][A-Za-z0-9_]*)\"$" "\\1" _n "${_n}")
  list(APPEND _registered "${_n}")
endforeach()
list(SORT _registered)
set(_want ${_ruled})
list(SORT _want)
if(NOT _registered STREQUAL _want)
  string(REPLACE ";" " " _r "${_registered}")
  string(REPLACE ";" " " _w "${_want}")
  string(APPEND _fail "main.cpp registers the context globals [${_r}], not the ruled [${_w}] (R-QML-1)\n")
endif()

# ── the members `app` has ─────────────────────────────────────────────────────────────────────────────────────────
set(_members ${_qobject})
foreach(_h "${GUI}/app/gui_app.h" "${APPH}")
  file(READ "${_h}" _hs)
  string(REGEX MATCHALL "Q_PROPERTY\\([^)]*[ *&]([A-Za-z_][A-Za-z0-9_]*)[ \t]+READ" _ps "${_hs}")
  foreach(_p IN LISTS _ps)
    string(REGEX REPLACE ".*[ *&]([A-Za-z_][A-Za-z0-9_]*)[ \t]+READ$" "\\1" _p "${_p}")
    list(APPEND _members "${_p}")
  endforeach()
  string(REGEX MATCHALL "Q_INVOKABLE[^(;]*[ *&]([A-Za-z_][A-Za-z0-9_]*)[ \t]*\\(" _is "${_hs}")
  foreach(_i IN LISTS _is)
    string(REGEX REPLACE ".*[ *&]([A-Za-z_][A-Za-z0-9_]*)[ \t]*\\($" "\\1" _i "${_i}")
    list(APPEND _members "${_i}")
  endforeach()
  # signals: every `void name(` between "signals:" and the next access label
  string(REGEX MATCHALL "signals:[^:]*" _sigs "${_hs}")
  foreach(_s IN LISTS _sigs)
    string(REGEX MATCHALL "void[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*\\(" _vs "${_s}")
    foreach(_v IN LISTS _vs)
      string(REGEX REPLACE "^void[ \t]+([A-Za-z_][A-Za-z0-9_]*).*" "\\1" _v "${_v}")
      list(APPEND _members "${_v}")
    endforeach()
  endforeach()
endforeach()
foreach(_m IN LISTS _moved)
  if(_m STREQUAL "controller")
    set(_m transcriptionController)
  endif()
  if(NOT _m IN_LIST _members)
    string(APPEND _fail "gui_app.h: `app` has no member ${_m}\n")
  endif()
endforeach()

# ── 2 and 3. the production QML and JS ────────────────────────────────────────────────────────────────────────────
file(GLOB_RECURSE _files LIST_DIRECTORIES false "${GUI}/*.qml" "${GUI}/*.js")
set(_kept "")
foreach(_f IN LISTS _files)
  file(RELATIVE_PATH _rel "${GUI}" "${_f}")
  if(NOT _rel MATCHES "^tests/")
    list(APPEND _kept "${_f}")
  endif()
endforeach()
set(_files ${_kept})
set(_movedAlt "")
string(REPLACE ";" "|" _movedAlt "${_moved}")
set(_nfiles 0)
foreach(_f IN LISTS _files)
  math(EXPR _nfiles "${_nfiles} + 1")
  file(RELATIVE_PATH _rel "${GUI}" "${_f}")
  file(READ "${_f}" _s)
  # Blank strings, template literals and line comments, none across a line (so line numbers hold).
  string(REGEX REPLACE [=["([^"\
]|\\.)*"|'([^'\
]|\\.)*'|`([^`\
]|\\.)*`|//[^
]*]=] "" _s "${_s}")
  # Neutralise what a CMake list would read: ; [ ] and \ (no string is left, so none of them matters now).
  string(REPLACE ";" "${_SEMI}" _s "${_s}")
  string(REPLACE "[" "${_LBR}" _s "${_s}")
  string(REPLACE "]" "${_RBR}" _s "${_s}")
  string(REPLACE "\\" "${_BSL}" _s "${_s}")

  # Which of the checks this file needs (block comments come out line by line, below)
  set(_wantsApp FALSE)
  if(_s MATCHES "(^|[^A-Za-z0-9_$.])app[ \t]*[?]?[.]")
    set(_wantsApp TRUE)
  endif()
  set(_wantsOld FALSE)
  if(_s MATCHES "(^|[^A-Za-z0-9_$.])(${_movedAlt})([^A-Za-z0-9_$]|$)")
    set(_wantsOld TRUE)
  endif()
  if(NOT _wantsApp AND NOT _wantsOld)
    continue()
  endif()

  # Each line keeps a leading space: a CMake list drops an empty element, which would shift every line number after it.
  string(REPLACE "\n" "; " _lines " ${_s}")
  # Pass 1: block comments out, brace pairs, and each moved name's declarations.
  set(_inBlock FALSE)
  set(_clean "")
  set(_stack "")
  set(_depth 0)
  set(_ln 0)
  set(_decls "")          # name|open line|depth at the declaration
  set(_pairs "")          # open line|close line
  foreach(_l IN LISTS _lines)
    math(EXPR _ln "${_ln} + 1")
    if(_inBlock)
      string(FIND "${_l}" "*/" _e)
      if(_e EQUAL -1)
        set(_l "")
      else()
        math(EXPR _e "${_e} + 2")
        string(SUBSTRING "${_l}" ${_e} -1 _l)
        set(_inBlock FALSE)
      endif()
    endif()
    while(NOT _inBlock)
      string(FIND "${_l}" "/*" _b)
      if(_b EQUAL -1)
        break()
      endif()
      string(SUBSTRING "${_l}" 0 ${_b} _head)
      string(SUBSTRING "${_l}" ${_b} -1 _tail)
      string(FIND "${_tail}" "*/" _e)
      if(_e EQUAL -1)
        set(_l "${_head}")
        set(_inBlock TRUE)
      else()
        math(EXPR _e "${_e} + 2")
        string(SUBSTRING "${_tail}" ${_e} -1 _tail)
        set(_l "${_head} ${_tail}")
      endif()
    endwhile()
    list(APPEND _clean " ${_l}")
    if(NOT _wantsOld)
      continue()
    endif()
    # a declaration on this line, at the depth before this line's braces (QML puts one per line)
    if(_l MATCHES "(^|[^A-Za-z0-9_$.])property[ \t]+[A-Za-z0-9_<>.]+[ \t]+(${_movedAlt})([^A-Za-z0-9_$]|$)")
      set(_dn "${CMAKE_MATCH_2}")
      list(LENGTH _stack _sd)
      if(_sd GREATER 0)
        list(GET _stack -1 _open)
      else()
        set(_open 0)
      endif()
      list(APPEND _decls "${_dn}|${_open}|${_depth}")
    endif()
    string(REGEX MATCHALL "[{}]" _br "${_l}")
    foreach(_c IN LISTS _br)
      if(_c STREQUAL "{")
        list(APPEND _stack ${_ln})
        math(EXPR _depth "${_depth} + 1")
      elseif(_depth GREATER 0)
        list(POP_BACK _stack _o)
        list(APPEND _pairs "${_o}|${_ln}")
        math(EXPR _depth "${_depth} - 1")
      endif()
    endforeach()
  endforeach()

  # The scopes each moved name is a property in: name|first line|last line.
  set(_scopes "")
  foreach(_d IN LISTS _decls)
    string(REPLACE "|" ";" _d "${_d}")
    list(GET _d 0 _dn)
    list(GET _d 1 _open)
    list(GET _d 2 _dd)
    if(_dd LESS_EQUAL 1 AND _rel MATCHES "[.]qml$")
      list(APPEND _scopes "${_dn}|0|999999")   # the root object's: the whole file
    else()
      set(_close 999999)
      foreach(_p IN LISTS _pairs)
        if(_p MATCHES "^${_open}[|]([0-9]+)$")
          set(_close ${CMAKE_MATCH_1})
        endif()
      endforeach()
      list(APPEND _scopes "${_dn}|${_open}|${_close}")
    endif()
  endforeach()

  # Pass 2: the reads.
  set(_ln 0)
  foreach(_l IN LISTS _clean)
    math(EXPR _ln "${_ln} + 1")
    if(_wantsApp AND _l MATCHES "(^|[^A-Za-z0-9_$.])app[ \t]*[?]?[.]")
      string(REGEX MATCHALL "(^|[^A-Za-z0-9_$.])app[ \t]*[?]?[.][ \t]*[A-Za-z_$][A-Za-z0-9_$]*" _ams "${_l}")
      foreach(_am IN LISTS _ams)
        string(REGEX REPLACE ".*[.][ \t]*([A-Za-z_$][A-Za-z0-9_$]*)$" "\\1" _am "${_am}")
        if(NOT _am IN_LIST _members)
          string(APPEND _fail "${_rel}:${_ln}: app.${_am} is not a member of `app` (gui_app.h, app.h): QML reads it as undefined\n")
        endif()
      endforeach()
    endif()
    if(NOT _wantsOld OR NOT _l MATCHES "(^|[^A-Za-z0-9_$.])(${_movedAlt})([^A-Za-z0-9_$]|$)")
      continue()
    endif()
    foreach(_nm IN LISTS _moved)
      string(LENGTH "${_nm}" _nl)
      set(_rest "${_l}")
      set(_before "")
      while(TRUE)
        string(REGEX MATCH "(^|[^A-Za-z0-9_$.])${_nm}([^A-Za-z0-9_$]|$)" _hit "${_rest}")
        if(_hit STREQUAL "")
          break()
        endif()
        string(FIND "${_rest}" "${_hit}" _at)
        if(NOT _hit MATCHES "^${_nm}")
          math(EXPR _at "${_at} + 1")
        endif()
        math(EXPR _post "${_at} + ${_nl}")
        string(SUBSTRING "${_rest}" 0 ${_at} _pre)
        string(SUBSTRING "${_rest}" ${_post} -1 _after)
        set(_ok FALSE)
        # inside its own property's scope
        foreach(_sc IN LISTS _scopes)
          string(REPLACE "|" ";" _sc "${_sc}")
          list(GET _sc 0 _sn)
          list(GET _sc 1 _a)
          list(GET _sc 2 _b)
          if(_sn STREQUAL _nm AND _ln GREATER_EQUAL _a AND _ln LESS_EQUAL _b)
            set(_ok TRUE)
          endif()
        endforeach()
        # a binding or object key, not a read: `name:` at the start of a line, an object or a list item
        if(NOT _ok AND _after MATCHES "^[ \t]*:" AND NOT _after MATCHES "^[ \t]*::"
           AND "${_before}${_pre}" MATCHES "(^|[{,${_SEMI}])[ \t]*$")
          set(_ok TRUE)
        endif()
        if(NOT _ok)
          set(_to "${_nm}")
          if(_nm STREQUAL "controller")
            set(_to transcriptionController)
          endif()
          string(APPEND _fail "${_rel}:${_ln}: `${_nm}` is read bare; it is app.${_to} (R-QML-1)\n")
        endif()
        string(SUBSTRING "${_rest}" 0 ${_post} _done)
        string(APPEND _before "${_done}")
        set(_rest "${_after}")
      endwhile()
    endforeach()
  endforeach()
endforeach()

if(_fail)
  message(FATAL_ERROR "FAIL:\n${_fail}")
endif()
list(LENGTH _members _nm)
message(STATUS "PASS: main.cpp registers the ${_nnamed} ruled context globals; ${_nfiles} QML and JS files read none of "
               "the five moved names bare, and only the ${_nm} members `app` has")
