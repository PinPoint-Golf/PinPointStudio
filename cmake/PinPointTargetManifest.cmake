# PinPointTargetManifest.cmake — what each target of a build tree compiles and links, read from CMake itself at the end
# of a configure; shared by the test umbrella (tests/CMakeLists.txt) and the app build (the root CMakeLists.txt).
#
#   pp_target_manifest(<dir> <out-var>)   the manifest of every target under <dir>, as text, one item a line:
#     T <target>   every executable and in-tree library target (IMPORTED ones are not in BUILDSYSTEM_TARGETS)
#     K <type>     its TYPE (EXECUTABLE, STATIC_LIBRARY, OBJECT_LIBRARY, INTERFACE_LIBRARY, ...)
#     S <source>   each of its SOURCES and INTERFACE_SOURCES, made absolute; a source inside a generator expression is
#                  listed by the path inside it, whatever the condition (stricter, never looser)
#     L <target>   each in-tree target it links: LINK_LIBRARIES and INTERFACE_LINK_LIBRARIES ($<LINK_ONLY:..> and other
#                  generator expressions opened, ALIAS targets resolved) and every $<TARGET_OBJECTS:..> in its sources
#     G <text>     a generator expression it could not read a path or a target from
#     X <test>     every test name
#   The test tree writes it to store_isolation_manifest.txt, which store_isolation_lint_test and
#   library_membership_lint_test read at run time.
#
#   pp_check_library_membership(<manifest-text> <src-root>)   fails the configure when a source under <src-root> is in
#     two in-tree libraries (rule 1), or is listed by an executable that also reaches, through its links, a library
#     holding it (rule 2). A header counts only when moc reads it (Q_OBJECT, Q_GADGET, Q_NAMESPACE): two copies of its
#     meta-object are a duplicate symbol; a plain header listed twice compiles nothing. The app tree runs it (it has no
#     lint suite, and the studio PC's MSVC would otherwise meet a duplicate only at the link, as LNK2005); the test
#     tree runs the same rules and more in library_membership_lint_test, with fixtures.
#
# Plain CMake, so it is the same under Ninja (the Mac) and NMake JOM (the studio PC).

function(pp_target_manifest_link_item item out)
    set(_found "")
    if(item MATCHES "^::@")                       # the directory marker of a target_link_libraries from elsewhere
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    if(item MATCHES "\\$<")
        string(REGEX MATCHALL "[A-Za-z0-9_.+-]+(::[A-Za-z0-9_.+-]+)*" _cands "${item}")
    else()
        set(_cands "${item}")
    endif()
    foreach(_c IN LISTS _cands)
        if(NOT TARGET "${_c}")
            continue()
        endif()
        get_target_property(_real "${_c}" ALIASED_TARGET)
        if(_real)
            set(_c "${_real}")
        endif()
        get_target_property(_imp "${_c}" IMPORTED)
        if(NOT _imp)
            list(APPEND _found "${_c}")
        endif()
    endforeach()
    set(${out} "${_found}" PARENT_SCOPE)
endfunction()
# The path inside a generator-expression source, whatever its conditions: each innermost $<K:V> becomes V when V names
# a file (holds a / or a .), else 1 (a condition), until no $< is left. Empty when it cannot be read.
function(pp_target_manifest_genex_path s out)
    set(_v "${s}")
    foreach(_i RANGE 32)
        if(NOT _v MATCHES "\\$<([^$<>]*)>")
            break()
        endif()
        set(_whole "${CMAKE_MATCH_0}")
        set(_body "${CMAKE_MATCH_1}")
        string(FIND "${_body}" ":" _colon)
        set(_val "1")
        if(_colon GREATER_EQUAL 0)
            math(EXPR _from "${_colon} + 1")
            string(SUBSTRING "${_body}" ${_from} -1 _val)
            if(NOT _val MATCHES "[/.]")
                set(_val "1")
            endif()
        endif()
        string(REPLACE "${_whole}" "${_val}" _v "${_v}")
    endforeach()
    if(_v MATCHES "[$<>]")
        set(_v "")
    endif()
    set(${out} "${_v}" PARENT_SCOPE)
endfunction()
function(pp_target_manifest_walk dir)
    get_property(_targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_t IN LISTS _targets)
        get_target_property(_type ${_t} TYPE)
        if(NOT _type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY|INTERFACE_LIBRARY)$")
            continue()
        endif()
        get_target_property(_sdir ${_t} SOURCE_DIR)
        string(APPEND PP_TARGET_MANIFEST "T ${_t}\nK ${_type}\n")
        set(_srcs "")
        set(_links "")
        foreach(_p SOURCES INTERFACE_SOURCES)
            get_target_property(_v ${_t} ${_p})
            if(_v)
                list(APPEND _srcs ${_v})
            endif()
        endforeach()
        foreach(_p LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(_v ${_t} ${_p})
            if(_v)
                list(APPEND _links ${_v})
            endif()
        endforeach()
        foreach(_s IN LISTS _srcs)
            if(_s MATCHES "\\$<")
                string(REGEX MATCHALL "TARGET_OBJECTS:[^>]+" _objs "${_s}")
                if(_objs)
                    foreach(_o IN LISTS _objs)
                        string(REPLACE "TARGET_OBJECTS:" "" _o "${_o}")
                        list(APPEND _links "${_o}")
                    endforeach()
                    continue()
                endif()
                # $<$<cond>:path> and the like: the path, whatever the condition; a G line when there is none, or
                # it names no file.
                pp_target_manifest_genex_path("${_s}" _inner)
                if(_inner STREQUAL "")
                    string(APPEND PP_TARGET_MANIFEST "G ${_s}\n")
                    continue()
                endif()
                cmake_path(ABSOLUTE_PATH _inner BASE_DIRECTORY "${_sdir}" NORMALIZE OUTPUT_VARIABLE _abs)
                if(NOT EXISTS "${_abs}")
                    string(APPEND PP_TARGET_MANIFEST "G ${_s}\n")
                    continue()
                endif()
                set(_s "${_abs}")
            endif()
            cmake_path(ABSOLUTE_PATH _s BASE_DIRECTORY "${_sdir}" NORMALIZE OUTPUT_VARIABLE _abs)
            string(APPEND PP_TARGET_MANIFEST "S ${_abs}\n")
        endforeach()
        set(_deps "")
        foreach(_l IN LISTS _links)
            pp_target_manifest_link_item("${_l}" _r)
            list(APPEND _deps ${_r})
        endforeach()
        list(REMOVE_DUPLICATES _deps)
        foreach(_d IN LISTS _deps)
            string(APPEND PP_TARGET_MANIFEST "L ${_d}\n")
        endforeach()
    endforeach()
    get_property(_tests DIRECTORY "${dir}" PROPERTY TESTS)
    foreach(_x IN LISTS _tests)
        string(APPEND PP_TARGET_MANIFEST "X ${_x}\n")
    endforeach()
    get_property(_subs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
    foreach(_d IN LISTS _subs)
        pp_target_manifest_walk("${_d}")
    endforeach()
    set(PP_TARGET_MANIFEST "${PP_TARGET_MANIFEST}" PARENT_SCOPE)
endfunction()
function(pp_target_manifest dir out)
    set(PP_TARGET_MANIFEST "")
    pp_target_manifest_walk("${dir}")
    set(${out} "${PP_TARGET_MANIFEST}" PARENT_SCOPE)
endfunction()

# 1 in <out> when <file> is a header moc reads (Q_OBJECT, Q_GADGET, Q_NAMESPACE), else 0.
function(pp_target_manifest_moc_header file out)
    set(${out} 0 PARENT_SCOPE)
    if(file MATCHES "\\.(h|hpp|hh)$" AND EXISTS "${file}")
        file(STRINGS "${file}" _hits REGEX "^[ \t]*(Q_OBJECT|Q_GADGET|Q_NAMESPACE)" LIMIT_COUNT 1)
        if(_hits)
            set(${out} 1 PARENT_SCOPE)
        endif()
    endif()
endfunction()

# 1 in <out> when <file> compiles to an object of its own, or is a header moc reads.
function(pp_target_manifest_counts file out)
    if(file MATCHES "\\.(c|cc|cpp|cxx|mm)$")
        set(${out} 1 PARENT_SCOPE)
    else()
        pp_target_manifest_moc_header("${file}" _moc)
        set(${out} ${_moc} PARENT_SCOPE)
    endif()
endfunction()

function(pp_check_library_membership text src_root)
    string(REPLACE ";" "," text "${text}")             # a ; would split a line; no path here holds one
    string(REPLACE "\n" ";" _lines "${text}")
    set(_targets "")
    set(_id "")
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^T (.+)$")
            set(_t "${CMAKE_MATCH_1}")
            string(MAKE_C_IDENTIFIER "${_t}" _id)
            list(APPEND _targets "${_t}")
            set(_k_${_id} "")
            set(_s_${_id} "")
            set(_l_${_id} "")
        elseif(_id STREQUAL "")
            continue()
        elseif(_line MATCHES "^K (.+)$")
            set(_k_${_id} "${CMAKE_MATCH_1}")
        elseif(_line MATCHES "^S (.+)$")
            set(_s "${CMAKE_MATCH_1}")
            string(FIND "${_s}" "${src_root}/" _at)
            if(_at EQUAL 0)
                list(APPEND _s_${_id} "${_s}")
            endif()
        elseif(_line MATCHES "^L (.+)$")
            list(APPEND _l_${_id} "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    set(_bad "")
    # Rule 1: a source under src/ is in one library at most.
    foreach(_t IN LISTS _targets)
        string(MAKE_C_IDENTIFIER "${_t}" _id)
        if(NOT _k_${_id} MATCHES "^(STATIC|OBJECT|SHARED|MODULE)_LIBRARY$")
            continue()
        endif()
        foreach(_s IN LISTS _s_${_id})
            string(MAKE_C_IDENTIFIER "${_s}" _sid)
            if(DEFINED _own_${_sid})
                if(NOT _own_${_sid} STREQUAL _t)
                    pp_target_manifest_counts("${_s}" _c)
                    if(_c)
                        list(APPEND _bad "${_s} is in two libraries, ${_own_${_sid}} and ${_t}")
                    endif()
                endif()
            else()
                set(_own_${_sid} "${_t}")
            endif()
        endforeach()
    endforeach()
    # Rule 2: no executable lists a source of a library it reaches through its links.
    foreach(_t IN LISTS _targets)
        string(MAKE_C_IDENTIFIER "${_t}" _id)
        if(NOT _k_${_id} STREQUAL "EXECUTABLE")
            continue()
        endif()
        set(_reach "")
        set(_todo ${_l_${_id}})
        while(_todo)
            list(POP_FRONT _todo _l)
            if(_l IN_LIST _reach)
                continue()
            endif()
            list(APPEND _reach "${_l}")
            string(MAKE_C_IDENTIFIER "${_l}" _lid)
            if(DEFINED _l_${_lid})
                list(APPEND _todo ${_l_${_lid}})
            endif()
        endwhile()
        foreach(_s IN LISTS _s_${_id})
            string(MAKE_C_IDENTIFIER "${_s}" _sid)
            if(DEFINED _own_${_sid})
                if(_own_${_sid} IN_LIST _reach)
                    pp_target_manifest_counts("${_s}" _c)
                    if(_c)
                        list(APPEND _bad "${_t} lists ${_s}, which ${_own_${_sid}}, a library it links, already holds")
                    endif()
                endif()
            endif()
        endforeach()
    endforeach()
    if(_bad)
        list(JOIN _bad "\n  " _msg)
        message(FATAL_ERROR "Library membership (cmake/PinPointTargetManifest.cmake): a source would be built twice into "
                            "one link, a duplicate symbol under MSVC and a silent pick of one copy elsewhere. Take it out "
                            "of the executable's list (it comes from the library), or out of one of the libraries:\n  ${_msg}")
    endif()
    list(LENGTH _targets _n)
    message(STATUS "Library membership: ${_n} targets checked, no source in two libraries or in a library and its user")
endfunction()
