+    EXPECT_GT(feed.run(v.f1, v.f2), 0);
+    buf.pause();
+    const SwingWindow w2 = buf.copySwingWindow(v.f2 - kWindowUs, v.f2);
+    buf.resume();
+    EXPECT_NEAR(double(framesOn(w2, feed.lane[0])), 4.0 * kFps, 1.5) << "swing 2 has its whole 4 s";
+    EXPECT_NEAR(double(framesOn(w2, feed.lane[1])), 4.0 * kFps, 1.5);
+    const CaptureIntegrityVerdict c2 = judge(w2, v.i2);
+    EXPECT_TRUE(c2.ok && !c2.edgesShort()) << "nothing missing: no ⚠";
+    EXPECT_EQ(feed.refused, 0) << "no frame was refused at any point";
+
+    // Swing 3: whole too.
+    feed.run(v.f2, v.f3);
+    buf.pause();
+    const SwingWindow w3 = buf.copySwingWindow(v.f3 - kWindowUs, v.f3);
+    buf.resume();
+    EXPECT_NEAR(double(framesOn(w3, feed.lane[0])), 4.0 * kFps, 1.5) << "swing 3 has its whole 4 s, not 278 frames";
+    const CaptureIntegrityVerdict c3 = judge(w3, v.i3);
+    EXPECT_TRUE(c3.ok && !c3.edgesShort());
