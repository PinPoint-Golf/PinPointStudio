+    EXPECT_TRUE(std::holds_alternative<CameraFormat>(w1.formatOf(feed.lane[0]).format))
+        << "the copy keeps each source's format (the capture check finds the cameras by it)";
+    EXPECT_EQ(w1.formatOf(feed.lane[1]).device_serial, "dtl");
+
+    buf.stop();
+}
+
+// A copy needs no live buffer: the window outlives the rings entirely (a source deregistered,
+// the buffer stopped), which is what lets a queued shot survive whatever the capture does next.
+TEST(CaptureOverlap, ACopiedWindowOutlivesTheBuffer)
+{
+    Visit1 v;
+    std::unique_ptr<SwingWindow> w;
+    SourceId lane0 = kInvalidSourceId;
+    {
+        EventBuffer buf(config());
+        Feed feed{ buf, { buf.registerSource(camera("faceOn")), buf.registerSource(camera("dtl")) }, v.origin };
+        lane0 = feed.lane[0];
+        buf.start();
+        feed.run(v.origin, v.f1);
+        buf.pause();
+        w = std::make_unique<SwingWindow>(buf.copySwingWindow(v.f1 - kWindowUs, v.f1));
+        buf.stop();
+    }
+    ASSERT_GT(framesOn(*w, lane0), 0u);
+    int wrong = 0;
+    for (const IndexEntry &e : w->entriesFor(lane0)) {
+        const uint64_t n = uint64_t(std::llround(double(e.timestamp_us - v.origin) / kPeriodUs));
+        if (!stamped(w->payloadOf(e), 0, n)) ++wrong;
+    }
+    EXPECT_EQ(wrong, 0);
+}
