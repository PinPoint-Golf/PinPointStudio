+// The copy-out's backing (#281): every payload a window names, and every format it needs, owned.
+// One contiguous block per source, so a 4 s window of a 1 MB camera is one allocation, not 600.
+// Its bytes never move, so validate() is unconditionally true — there is no ring to race with.
+class OwnedPayloadSource final : public SwingPayloadSource {
+public:
+    struct Lane {
+        FormatDescriptor                                   format;
+        // Not a vector: resize() would zero-fill a gigabyte only for memcpy to overwrite it.
+        std::unique_ptr<std::byte[]>                       bytes;
+        size_t                                             size = 0;
+        std::unordered_map<uint64_t, std::pair<size_t, size_t>> at;   // sequence → {offset, length}
+        std::unordered_map<uint64_t, int64_t>              ts;         // sequence → timestamp_us
+    };
+    std::unordered_map<SourceId, Lane> lanes;
+
+    SourceRing::ReadHandle payloadOf(SourceId id, uint64_t sequence) const noexcept override {
+        const auto l = lanes.find(id);
+        if (l == lanes.end()) return {};
+        const auto it = l->second.at.find(sequence);
+        if (it == l->second.at.end()) return {};
+        SourceRing::ReadHandle h;
+        h.data  = l->second.bytes.get() + it->second.first;
+        h.bytes = it->second.second;
+        const auto t = l->second.ts.find(sequence);
+        h.timestamp_us = t == l->second.ts.end() ? 0 : t->second;
+        return h;
+    }
+    const FormatDescriptor& formatOf(SourceId id) const noexcept override {
+        const auto l = lanes.find(id);
+        if (l != lanes.end()) return l->second.format;
+        static const FormatDescriptor kEmpty{};
+        return kEmpty;
+    }
+    bool validate(SourceId, const SourceRing::ReadHandle&) const noexcept override {
+        return true;   // owned bytes — nothing can overwrite them
+    }
+};
+
+std::unique_ptr<const SwingPayloadSource> EventBuffer::copyPayloads(const std::vector<IndexEntry>& entries,
+                                                                    std::vector<IndexEntry>* copied,
+                                                                    size_t* bytes) {
+    assert(state_.load(std::memory_order_acquire) == BufferState::Paused
+           && "copyPayloads requires Paused state");
+    auto out = std::make_unique<OwnedPayloadSource>();
+    if (copied) { copied->clear(); copied->reserve(entries.size()); }
+    size_t total = 0;
+
+    // Two passes: size each source's block first, so the copy is one allocation per source and
+    // the handles taken in the second pass are the only reads of the rings.
+    std::unordered_map<SourceId, size_t> need;
+    for (const IndexEntry& e : entries) {
+        const SourceRing::ReadHandle h = acquireReadHandle(e.source_id, e.source_sequence);
+        if (h.data) need[e.source_id] += h.bytes;   // a zero-length payload still makes its lane
+    }
+    for (const auto& [id, n] : need) {
+        const int idx = findSlotIndex(id);
+        if (idx < 0) continue;
+        auto& lane  = out->lanes[id];
+        lane.format = sources_[idx]->desc.format;
+        lane.bytes.reset(new std::byte[n ? n : 1]);   // default-initialised: no zero fill
+        lane.size = n;
+    }
+    std::unordered_map<SourceId, size_t> used;
+    for (const IndexEntry& e : entries) {
+        const auto l = out->lanes.find(e.source_id);
+        if (l == out->lanes.end()) continue;
+        const SourceRing::ReadHandle h = acquireReadHandle(e.source_id, e.source_sequence);
+        if (!h.data) continue;   // overwritten before the pause: not in the window, as the ring would say
+        size_t& off = used[e.source_id];
+        if (off + h.bytes > l->second.size) continue;   // cannot happen while Paused
+        if (h.bytes) std::memcpy(l->second.bytes.get() + off, h.data, h.bytes);
+        l->second.at[e.source_sequence] = { off, h.bytes };
+        l->second.ts[e.source_sequence] = h.timestamp_us;
+        off   += h.bytes;
+        total += h.bytes;
+        if (copied) copied->push_back(e);
+    }
+    if (bytes) *bytes = total;
+    return out;
+}
+
+SwingWindow EventBuffer::copySwingWindow(int64_t t_start_us, int64_t t_end_us, size_t* bytes) {
+    assert(state_.load(std::memory_order_acquire) == BufferState::Paused
+           && "copySwingWindow requires Paused state");
+    std::vector<IndexEntry> kept;
+    auto source = copyPayloads(index_.snapshot(t_start_us, t_end_us), &kept, bytes);
+    return SwingWindow(std::move(source), std::move(kept), t_start_us, t_end_us);
+}
+
