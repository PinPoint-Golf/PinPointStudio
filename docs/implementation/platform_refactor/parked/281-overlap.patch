+    // Swing 1's copy, read after the rings have wrapped (~1,700 frames a lane since, 1,024 slots):
+    // every frame is still its own, byte for byte — the analysis of an earlier shot is safe.
+    feed.run(v.f3, v.f3 + 2'000'000);
+    int wrong = 0;
+    for (uint32_t l = 0; l < 2; ++l)
+        for (const IndexEntry &e : w1.entriesFor(feed.lane[l])) {
+            const SourceRing::ReadHandle h = w1.payloadOf(e);
+            const uint64_t n = uint64_t(std::llround(double(e.timestamp_us - v.origin) / kPeriodUs));
+            if (!stamped(h, l, n)) ++wrong;
