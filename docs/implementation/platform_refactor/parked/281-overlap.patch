+// ═══════════════════════════════ ShotPairing, two swings in flight at once (#281) ══
+// Visit 1 (25 Nov 2026, Wrist_02; docs/implementation/platform_refactor/notes/NOTES-281.md): swing 2 was hit while swing 1
+// analysed, and swing 3's reading arrived before its shot was committed (the GUI thread was busy
+// with swing 1's join). Premier readings are timed (contactAtMs), as there.
+
+namespace {
+LaunchMonitorReading premier(const QString &id, qint64 contactMs)
+{
+    LaunchMonitorReading r = readingWithId(id);
+    r.contactAtMs = contactMs;
+    return r;
+}
+constexpr qint64 kVisitT1 = 1'795'000'000'000;   // swing 1's impact, wall clock ms
+} // namespace
+
+TEST(ShotPairingInFlight, EachSwingKeepsItsOwnReadingWhileAnEarlierOneAnalyses)
+{
+    ShotPairing p;
+    p.noteShotDetected(kVisitT1);                                         // swing 1
+    ASSERT_EQ(p.offerReading(premier(QStringLiteral("36e08446"), kVisitT1 + 34)).disposition,
+              ShotPairing::Disposition::Parked);
+
+    p.noteShotDetected(kVisitT1 + 8'500);                                 // swing 2, swing 1 analysing
+    const auto two = p.offerReading(premier(QStringLiteral("8a790d49"), kVisitT1 + 8'520));
+    EXPECT_EQ(two.disposition, ShotPairing::Disposition::Parked) << "visit 1: 'no shot waiting; discarded'";
+    EXPECT_EQ(two.timeCheck, ShotPairing::TimeCheck::Matched);
+
+    // Premier's club data for swing 1 lands with swing 2's reading: it still finds swing 1's.
+    LaunchMonitorReading fuller = premier(QStringLiteral("36e08446"), kVisitT1 + 34);
+    fuller.faceAngle = 1.5;
+    EXPECT_TRUE(p.replaceParked(fuller));
+
+    // The pipeline finishes them in order.
+    const auto r1 = p.noteSwingDir(QStringLiteral("/swings/0001"));
+    ASSERT_TRUE(r1.has_value());
+    EXPECT_EQ(r1->deviceShotId.toStdString(), "36e08446") << "swing 1's reading, not swing 2's";
+    ASSERT_TRUE(r1->faceAngle);
+    EXPECT_DOUBLE_EQ(*r1->faceAngle, 1.5);
+    const auto r2 = p.noteSwingDir(QStringLiteral("/swings/0002"));
+    ASSERT_TRUE(r2.has_value());
+    EXPECT_EQ(r2->deviceShotId.toStdString(), "8a790d49");
+}
+
+TEST(ShotPairingInFlight, AReadingThatArrivesBeforeItsShotIsCommittedIsAttachedByItsContactTime)
+{
+    // Swing 3: Premier's reading came before the arbiter committed the shot, so nothing was armed.
+    // Held (it is timed), it is attached when the shot it matches is committed.
+    ShotPairing p;
+    const qint64 t3 = kVisitT1 + 16'060;
+    const auto early = p.offerReading(premier(QStringLiteral("82f81b3a"), t3 + 40));
+    ASSERT_EQ(early.disposition, ShotPairing::Disposition::Discarded);
+    p.holdUnclaimed(premier(QStringLiteral("82f81b3a"), t3 + 40));
+
+    const auto adopted = p.noteShotDetected(t3);
+    ASSERT_TRUE(adopted.has_value()) << "the held reading matches this impact";
+    EXPECT_EQ(*adopted, 40);
+    EXPECT_FALSE(p.armed()) << "the swing has its reading";
+    const auto r3 = p.noteSwingDir(QStringLiteral("/swings/0003"));
+    ASSERT_TRUE(r3.has_value());
+    EXPECT_EQ(r3->deviceShotId.toStdString(), "82f81b3a");
+}
+
+TEST(ShotPairingInFlight, AHeldReadingIsNeverGivenToAShotItDoesNotMatch)
+{
+    ShotPairing p;
+    p.holdUnclaimed(premier(QStringLiteral("stray"), kVisitT1));        // a ball we never detected
+    EXPECT_FALSE(p.noteShotDetected(kVisitT1 + 8'000).has_value()) << "8 s off: another ball";
+    EXPECT_TRUE(p.armed()) << "this swing still waits for its own";
+    EXPECT_FALSE(p.noteSwingDir(QStringLiteral("/swings/x")).has_value());
+
+    ShotPairing q;
+    q.holdUnclaimed(readingWithId(QStringLiteral("untimed")));          // no contact time: order only
+    EXPECT_FALSE(q.noteShotDetected(kVisitT1).has_value());
+    EXPECT_FALSE(q.noteSwingDir(QStringLiteral("/swings/y")).has_value());
+}
+
+TEST(ShotPairingInFlight, ShotsDroppedInFlightTakeTheirReadingsWithThem)
+{
+    // finishNowBlocking() (a camera deselected, the app closing) drops every shot in flight
+    // without a folder: nothing they parked may reach the folders of the shots that follow.
+    ShotPairing p;
+    p.noteShotDetected(kVisitT1);
+    p.offerReading(premier(QStringLiteral("a"), kVisitT1 + 10));
+    p.noteShotDetected(kVisitT1 + 8'000);
+    p.offerReading(premier(QStringLiteral("b"), kVisitT1 + 8'010));
+    p.noteShotsDropped();
+    EXPECT_FALSE(p.hasParked());
+    EXPECT_FALSE(p.armed());
+
+    p.noteShotDetected(kVisitT1 + 30'000);
+    EXPECT_FALSE(p.noteSwingDir(QStringLiteral("/swings/next")).has_value());
+}
+
+TEST(ShotPairingInFlight, AFailedShotTakesOnlyItsOwnReading)
+{
+    ShotPairing p;
+    p.noteShotDetected(kVisitT1);
+    p.offerReading(premier(QStringLiteral("a"), kVisitT1 + 10));
+    p.noteShotDetected(kVisitT1 + 8'000);
+    p.offerReading(premier(QStringLiteral("b"), kVisitT1 + 8'010));
+
+    p.noteShotFailed();                                                  // swing 1: no folder
+    const auto r2 = p.noteSwingDir(QStringLiteral("/swings/0002"));
+    ASSERT_TRUE(r2.has_value());
+    EXPECT_EQ(r2->deviceShotId.toStdString(), "b");
+}
