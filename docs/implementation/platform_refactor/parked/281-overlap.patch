+// #281 part A — a swing hit while the previous one is being analysed, on the REAL event buffer
+// with a fake two-camera feed (G1: capture code lands with its fake and a test).
+//
+// Visit 1 (25 Nov 2026, Wrist_02; docs/implementation/platform_refactor/notes/NOTES-281.md §1): three swings about 8 s apart.
+// Swing 2 was never recorded, and swing 3's window held 278 frames of 595. The cause: from the
+// freeze of one shot until its analysis, export and write are done, the window reads the frozen
+// ring zero-copy, so the WHOLE buffer stays Paused — nothing is recorded — and resume() then
+// clears every ring, so the next window starts at the resume.
+//
+//   • TodaysProtocol… pins that mechanism, step by step, as ShotProcessor drove the buffer until
+//     #281 (pause at the freeze, the ring held for the shot's life, resume clearing the rings).
+//     It passes on the old code: it IS the reproduction.
+//   • CopyOutProtocol… is the fix's protocol (EventBuffer::copySwingWindow, then resume at once):
+//     every swing gets its whole window, and the earlier shot's copy survives the rings wrapping.
+//
+// The fake feed: two camera lanes at the studio's 150.714 fps, every frame's payload stamped with
+// its lane and frame number so a copy can be checked byte for byte. The timeline is synthetic
+// (fixed instants on the buffer clock), so nothing here sleeps for the swings' 16 s.
+
+#include "event_buffer.h"
+#include "swing_window.h"
+#include "../../Analysis/capture_integrity_check.h"
+
+#include <gtest/gtest.h>
+
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+using namespace pinpoint;
+using namespace std::chrono_literals;
+
+namespace {
+
+constexpr double  kFps       = 150.714;                 // the studio Chameleon3s, visit 1
+constexpr double  kPeriodUs  = 1'000'000.0 / kFps;      // 6635 µs
+constexpr int64_t kWindowUs  = 4'000'000;               // ShotProcessor kWindowDuration
+constexpr int64_t kFreezeUs  = 1'450'000;               // post-roll 1250 ms + the arbiter's 200 ms hold
+constexpr size_t  kPayload   = 4096;                    // a 64×64 Mono8 frame
+
+SourceDescriptor camera(const char *serial)
+{
+    SourceDescriptor d;
+    d.name            = serial;
+    d.identifier      = serial;
+    d.window_duration = std::chrono::milliseconds(5000);   // CameraInstance's: 1024 slots at 150 fps
+    CameraFormat f;
+    f.pixel_format          = PixelFormat::Mono8;
+    f.width                 = 64;
+    f.height                = 64;
+    f.fps_numerator         = 150714;
+    f.fps_denominator       = 1000;
+    f.max_payload_bytes     = kPayload;
+    f.typical_payload_bytes = kPayload;
+    d.format.device = DeviceKind::Camera_UVC;
+    d.format.format = f;
+    return d;
+}
+
+EventBufferConfig config()
+{
+    EventBufferConfig c;
+    c.reorder_window_us = 0;   // synthetic instants: nothing to reorder
+    return c;
+}
+
+// The frame's stamp: its lane and number, so a byte-for-byte check knows which frame it is reading.
+void stamp(std::byte *dst, uint32_t lane, uint64_t frame)
+{
+    std::memset(dst, int(frame & 0xFF), kPayload);
+    std::memcpy(dst, &frame, sizeof frame);
+    std::memcpy(dst + sizeof frame, &lane, sizeof lane);
+}
+bool stamped(const SourceRing::ReadHandle &h, uint32_t lane, uint64_t frame)
+{
+    if (!h.data || h.bytes != kPayload) return false;
+    uint64_t f = 0; uint32_t l = 0;
+    std::memcpy(&f, h.data, sizeof f);
+    std::memcpy(&l, h.data + sizeof f, sizeof l);
+    return f == frame && l == lane && h.data[kPayload - 1] == std::byte(frame & 0xFF);
+}
+
+// The fake camera: every frame due in [fromUs, toUs) on the 150.714 fps grid, on each lane.
+// Returns how many the buffer accepted (acquireWriteSlot refuses every frame while Paused).
+struct Feed {
+    EventBuffer &buf;
+    SourceId     lane[2];
+    int64_t      originUs;
+    int published = 0, refused = 0;
+
+    uint64_t frameAt(int64_t tUs) const { return uint64_t(std::ceil(double(tUs - originUs) / kPeriodUs)); }
+    int64_t  timeOf(uint64_t n) const   { return originUs + int64_t(std::llround(double(n) * kPeriodUs)); }
+
+    int run(int64_t fromUs, int64_t toUs)
+    {
+        int accepted = 0;
+        for (uint64_t n = frameAt(fromUs); timeOf(n) < toUs; ++n)
+            for (uint32_t l = 0; l < 2; ++l) {
+                auto slot = buf.acquireWriteSlot(lane[l]);
+                if (!slot.valid) { ++refused; continue; }
+                stamp(slot.data, l, n);
+                *slot.bytes_written = uint32_t(kPayload);
+                *slot.timestamp_us  = timeOf(n);
+                buf.publish(lane[l], slot.sequence);
+                ++accepted;
+            }
+        published += accepted;
+        std::this_thread::sleep_for(30ms);   // let the merger index them before a pause
+        return accepted;
+    }
+};
+
+size_t framesOn(const SwingWindow &w, SourceId id) { return w.entriesFor(id).size(); }
+
+CaptureIntegrityVerdict judge(const SwingWindow &w, int64_t impactUs)
+{
+    CaptureCoverageSpec cov;
+    cov.judge         = true;
+    cov.windowStartUs = w.startTimestampUs();
+    cov.windowEndUs   = w.endTimestampUs();
+    return checkCaptureIntegrity(w, impactUs, cov);
+}
+
+// The three impacts, as visit 1 had them: swing 2 about 8.5 s after swing 1, swing 3 16.06 s after
+// (impact_ts_us 1239041925217 − 1239025861653). Anchored 60 s in the past on the buffer clock.
+struct Visit1 {
+    int64_t origin = EventBuffer::nowMicros() - 60'000'000;
+    int64_t i1 = origin + 3'000'000;
+    int64_t i2 = i1 + 8'500'000;
+    int64_t i3 = i1 + 16'060'000;
+    int64_t f1 = i1 + kFreezeUs, f2 = i2 + kFreezeUs, f3 = i3 + kFreezeUs;
+};
+
+} // namespace
+
+// ─────────────────────────────────────────────────── the reproduction (today's protocol) ──
+
+TEST(CaptureOverlap, TodaysProtocol_SwingTwoIsNeverRecordedAndSwingThreeStartsAtTheResume)
+{
+    EventBuffer buf(config());
+    Visit1 v;
+    Feed feed{ buf, { buf.registerSource(camera("faceOn")), buf.registerSource(camera("dtl")) }, v.origin };
+    buf.start();
+
+    // Swing 1: the session has run since `origin`; at the freeze its window is whole.
+    feed.run(v.origin, v.f1);
+    buf.pause();                                              // beginGather(): pauseBuffer()
+    auto ring = buf.makeRingPayloadSource();                  // …and the resume guard goes up
+    auto entries = buf.snapshot(v.f1 - kWindowUs, v.f1);
+    auto w1 = std::make_unique<SwingWindow>(std::move(ring), std::move(entries), v.f1 - kWindowUs, v.f1);
+    EXPECT_NEAR(double(framesOn(*w1, feed.lane[0])), 4.0 * kFps, 1.5) << "swing 1's 4 s window is whole";
+    EXPECT_TRUE(buf.swingWindowLive()) << "the window holds the buffer Paused: CameraManager::resumeBuffer refuses";
+
+    // Swing 2, while swing 1 analyses: the cameras run, but the paused buffer takes no frame.
+    const int during = feed.run(v.i2 - 2'750'000, v.f2);
+    EXPECT_EQ(during, 0) << "not one frame of swing 2 reaches a ring — there is nothing to detect or save";
+    EXPECT_GT(feed.refused, 1000);
+
+    // Swing 1's join: finishShot() destroys the window and resumes — which CLEARS the rings.
+    // The resume comes 278 frames before swing 3's freeze, as visit 1's log puts it.
+    const int64_t resumeUs = v.f3 - int64_t(std::llround(278 * kPeriodUs));
+    w1.reset();
+    EXPECT_FALSE(buf.swingWindowLive());
+    buf.resume();
+    feed.run(resumeUs, v.f3);
+
+    // Swing 3: the same 4 s window, but the rings only reach back to the resume.
+    buf.pause();
+    const SwingWindow w3 = buf.captureSwingWindow(v.f3 - kWindowUs, v.f3);
+    EXPECT_NEAR(double(framesOn(w3, feed.lane[0])), 278.0, 1.0) << "visit 1: 278 frames per camera";
+    EXPECT_NEAR(double(framesOn(w3, feed.lane[1])), 278.0, 1.0);
+
+    // The cut is at the START (the pre-roll), not the end, and the capture check flags it (#53).
+    const CaptureIntegrityVerdict c = judge(w3, v.i3);
+    EXPECT_TRUE(c.lateStart) << "the clip starts at the resume, 2.155 s into its window";
+    EXPECT_NEAR(c.missingStartMs, 4000.0 - 278 * kPeriodUs / 1000.0, 10.0);
+    EXPECT_FALSE(c.earlyEnd) << "the post-roll is whole";
+    EXPECT_TRUE(c.ok) << "frames before impact exist, so it warns rather than withholds";
+    EXPECT_GT(c.framesBeforeImpact, 0);
+    EXPECT_LT(c.framesBeforeImpact, int(0.5 * kFps)) << "under half a second before impact: no backswing";
+    EXPECT_TRUE(c.edgesShort()) << "the shot carries the ⚠ (shot.captureShort)";
+
+    buf.stop();
+}
+
+// ───────────────────────────────────────────────────────────── the fix (copy out, resume) ──
+
+TEST(CaptureOverlap, CopyOutProtocol_EverySwingGetsItsWholeWindowWhileAnEarlierOneAnalyses)
+{
+    EventBuffer buf(config());
+    Visit1 v;
+    Feed feed{ buf, { buf.registerSource(camera("faceOn")), buf.registerSource(camera("dtl")) }, v.origin };
+    buf.start();
+
+    // Swing 1: freeze, copy out, resume AT ONCE. Its analysis now holds a copy, not the buffer.
+    feed.run(v.origin, v.f1);
+    buf.pause();
+    size_t bytes1 = 0;
+    const SwingWindow w1 = buf.copySwingWindow(v.f1 - kWindowUs, v.f1, &bytes1);
