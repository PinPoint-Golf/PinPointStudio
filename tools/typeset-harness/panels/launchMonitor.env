# Launch monitor (PpLaunchMonitorPanel.qml) — a STARTING POINT, unproven. No objectName: reached by its
# stage key. The 4 July fixture has no launch-monitor readings: pick a session with them
# (TYPESET_SESSION) or the panel shows its empty state only. graphicsMode follows appSettings.lmPanelMode.
TARGET=key:launchMonitor
PANEL_KEY=launchMonitor
FEED=sessionShots,reviewing,graphicsMode
VIEWS=main
