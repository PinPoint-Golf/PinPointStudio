# Launch monitor (PpLaunchMonitorPanel.qml) — a STARTING POINT, unproven. No objectName: reached by its
# stage key. The 4 July fixture has no launch-monitor readings: pick a session with them
# (TYPESET_SESSION) or the panel shows its empty state only. The FSX design is the whole panel (no Tiles/Graphics switch): TAB_PROP and VIEW_PROP are its `tab` (shot | session).
TARGET=key:launchMonitor
PANEL_KEY=launchMonitor
FEED=sessionShots,reviewing
TAB_PROP=tab
VIEW_PROP=tab
VIEWS=shot,session
