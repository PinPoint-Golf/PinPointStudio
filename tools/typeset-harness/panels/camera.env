# Camera (PpCameraTiles.qml) — chrome only: video draws nothing offscreen, so only the overlays, labels
# and gutters can be judged in a render; judge the video in the live try-out. A STARTING POINT, unproven.
TARGET=key:camera
PANEL_KEY=camera
FEED=_replayStreams,_replaySeries,_replayImpact
VIEWS=main
