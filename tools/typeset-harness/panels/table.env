# Table (PpDataViewer.qml) — a STARTING POINT, unproven. No objectName: reached by its stage key.
# It reads the focused swing.json through an inner object with the id `src`, which an overlay cannot
# reach; expose it on the root before mocking. Sections: scopeCollapsed / coverageCollapsed / tableCollapsed.
TARGET=key:table
PANEL_KEY=table
FEED=swingDir,hasSwing
VIEWS=main
