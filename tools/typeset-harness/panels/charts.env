# Charts (PpReplayCharts.qml) — a STARTING POINT, unproven: confirm at step 1 (inventory) with a
# dump (render.sh --panel charts --dump none charts_data half). No objectName: reached by its stage key.
# Its data: _detail (shotReplay.analysisDetail) and _series. No tabs.
TARGET=key:charts
PANEL_KEY=charts
FEED=_detail,_series
VIEWS=main
