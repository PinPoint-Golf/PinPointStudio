# Wrist motion analysis (WristDiagnostics.qml) — a STARTING POINT, unproven. No objectName: reached by
# its stage key. Its data lives in an inner WristDiagnosticsModel with the id `dx`, which an overlay
# cannot reach: expose it on the root (e.g. `readonly property alias model: dx`), a src change that
# costs a build, before mocking. `_pos` is the selected position's record.
TARGET=key:wristMotion
PANEL_KEY=wristMotion
FEED=_pos
VIEWS=main
